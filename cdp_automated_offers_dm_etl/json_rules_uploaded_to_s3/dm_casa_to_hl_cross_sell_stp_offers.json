        { "field": "is_enfis_flag", "operator": "=", "value": 0 },
        { "field": "is_dnc_flag", "operator": "=", "value": 0 },
        { "field": "is_risk_industry_flag", "operator": "=", "value": 0 },
        { "field": "client_segment_name", "operator": "!= (IGNORE CASE TRIM)", "value": "WEALTH" },
        { "field": "age", "operator": "BETWEEN", "value": [21, 55] },
        { "field": "is_with_salad_flag", "operator": "=", "value": 0 },
        { "field": "is_with_csl_flag", "operator": "=", "value": 0 },
        { "field": "is_with_pl_acct_woff_flag", "operator": "=", "value": 0 },
        { "field": "adb_3m_avg", "operator": ">=", "value": 125000 },
